## Abilities that can never be copied or suppressed (Skill Swap / Mummy / Power of Alchemy / Receiver).
const FIXED_ABILITY_NAMES := ["Multitype", "Stance Change", "Schooling", "Comatose", "Shields Down",
	"Disguise", "RKS System", "Battle Bond", "Power Construct", "Ice Face", "Gulp Missile", "As One",
	"Zero to Hero", "Commander", "Tera Shift", "Tera Shell", "Teraform Zero", "Poison Puppeteer"]

## The hook dictionary for a battler's ability ({} if none, suppressed by Gastro Acid / Core Enforcer
## ("ability_off"), or ignored because the mon currently attacking it has Mold Breaker).
## Falls back to FALLBACK_BY_NAME (by ROM ability name) when the profile has no entry.
static func hook(st, m: BattleMon) -> Dictionary:
	if m == null or m.vol.has("ability_off"):
		return {}
	var h: Dictionary = st.bd.ability_hook(m.ability)
	if h.is_empty():
		h = FALLBACK_BY_NAME.get(st.bd.ability_name(m.ability), {})
	if h.is_empty():
		return h
	# Neutralizing Gas suppresses every other ability on the field (but never itself or another NG).
	if str(h.get("k", "")) != "neutralizing_gas":
		for x in st.all_active():
			if x != m and _raw_key(st, x.ability) == "neutralizing_gas":
				return {}
	var ex: BattleMon = st._executing
	if ex != null and ex != m and str(h.get("k", "")) in BREAKABLE:
		var ek := _raw_key(st, ex.ability)
		if ek == "mold_breaker" and not ex.vol.has("ability_off"):
			return {}
		# Mycelium Might ignores the target's ability only for status moves (the move in progress
		# is st.last_move_any while a move executes).
		if ek == "mycelium_might" and not ex.vol.has("ability_off"):
			var lm: Dictionary = st.bd.move(int(st.last_move_any)) if int(st.last_move_any) > 0 else {}
			if int(lm.get("cat", -1)) == 2:
				return {}
	return h

## The hook dictionary for an ability id WITHOUT any suppression (profile, then name fallback).
## Used by hook() itself (Neutralizing Gas / Mold Breaker checks must not recurse through hook()).
static func _raw_hook(st, ability_id: int) -> Dictionary:
	var h: Dictionary = st.bd.ability_hook(ability_id)
	if h.is_empty():
		h = FALLBACK_BY_NAME.get(st.bd.ability_name(ability_id), {})
	return h

static func _raw_key(st, ability_id: int) -> String:
	return str(_raw_hook(st, ability_id).get("k", ""))

## Our hook key for a battler's ability ("" when none).
static func key(st, m: BattleMon) -> String:
	return str(hook(st, m).get("k", ""))

static func _k(st, m: BattleMon) -> String:
	return key(st, m)

## True when any active mon has Cloud Nine / Air Lock (weather has no effect).
static func weather_suppressed(st) -> bool:
	for m in st.all_active():
		if _k(st, m) == "cloud_nine":
			return true
	return false

# ------------------------------------------------------------------ damage modifiers (4096-based)

## Base-power modifiers from the attacker's and the defender's abilities (Showdown onBasePower /
## onSourceBasePower). `mv` is the move as it executes (type already changed by -ate abilities etc.).
static func power_mods(st, user: BattleMon, target: BattleMon, mv: Dictionary, power: int) -> Array:
	var out: Array = []
	var h := hook(st, user)
	match str(h.get("k", "")):
		"technician": if power <= 60: out.append(6144)
		"sheer_force": if mv.get("has_secondary", false): out.append(5325)
		"flag_boost": if mv.get(str(h.flag), false): out.append(int(float(h.m) * 4096))
		"punk_rock": if mv.get("sound", false): out.append(5325)
		"reckless": if mv.get("recoil_move", false): out.append(4915)
		"ate", "normalize": if mv.get("ate_boost", false): out.append(4915)
		"sand_force":
			if st.weather == "sand" and not weather_suppressed(st) and int(mv.type) in [TypeChart.ROCK, TypeChart.GROUND, TypeChart.STEEL]:
				out.append(5325)
		"analytic": if st.is_last_to_act(user): out.append(5325)
		"rivalry":
			if user.gender in [0, 1] and target.gender in [0, 1]:
				out.append(5120 if user.gender == target.gender else 3072)
	# Ally auras (Power Spot / Battery boost the user's moves; Steely Spirit / Victory Star are user+ally;
	# Dark/Fairy Aura and the Ruin abilities are field-wide — see _aura_mult / _ruin_mult).
	if st.is_doubles():
		var al = st.ally_of(user)
		if al != null:
			match _k(st, al):
				"power_spot": out.append(5325)
				"battery": if int(mv.cat) == 1: out.append(5325)
				"steely_spirit": if int(mv.type) == TypeChart.STEEL: out.append(6144)
	if int(mv.type) == TypeChart.STEEL and _k(st, user) == "steely_spirit":
		out.append(6144)
	match str(h.get("k", "")):
		"orichalcum_pulse": if int(mv.cat) == 0 and st.weather == "sun" and not weather_suppressed(st): out.append(5461)
		"hadron_engine": if int(mv.cat) == 1 and st.terrain == "electric": out.append(5461)
		"wind_power": if user.vol.has("wind_charged") and int(mv.type) == TypeChart.ELECTRIC: out.append(8192)
		"electromorphosis": if user.vol.has("electro_charged") and int(mv.type) == TypeChart.ELECTRIC: out.append(8192)
		"supreme_overlord":
			var fainted := 0
			for x in st.sides[user.side_id].mons:
				if x.fainted():
					fainted += 1
			out.append(mini(6144, 4096 + 410 * fainted))
	var am := _aura_mult(st, int(mv.type))
	if am != 4096:
		out.append(am)
	var th := hook(st, target)
	if str(th.get("k", "")) == "dry_skin" and int(mv.type) == TypeChart.FIRE:
		out.append(5120)
	return out

## Attack-stat modifiers (Showdown onModifyAtk / onModifySpA, plus the defender's onSourceModifyAtk).
static func atk_mods(st, user: BattleMon, target: BattleMon, mv: Dictionary, special: bool) -> Array:
	var out: Array = []
	var h := hook(st, user)
	match str(h.get("k", "")):
		"double_atk": if not special: out.append(8192)
		"guts": if not special and user.status != "": out.append(6144)
		"pinch_boost": if int(mv.type) == int(h.type) and user.hp * 3 <= user.max_hp(): out.append(6144)
		"solar_power": if special and st.weather == "sun" and not weather_suppressed(st): out.append(6144)
		"type_atk": if int(mv.type) == int(h.type): out.append(6144)
		"water_bubble": if int(mv.type) == TypeChart.WATER: out.append(8192)
		"defeatist": if user.hp * 2 <= user.max_hp(): out.append(2048)
		"flare_boost": if special and user.status == "brn": out.append(6144)
		"toxic_boost": if not special and user.status in ["psn", "tox"]: out.append(6144)
		"paradox":
			if paradox_active(st, user, h):
				var best := best_stat(user)
				if (best == "atk" and not special) or (best == "spa" and special):
					out.append(5325)
		"slow_start": if not special and int(user.vol.get("turns_in", 0)) < 5: out.append(2048)
		"gorilla_tactics": if not special: out.append(6144)
	if special and _plus_minus_active(st, user):
		out.append(6144)   # Plus / Minus: SpA x1.5 when an ally has Plus or Minus (doubles only)
	if _flower_gift_active(st, user) and not special:
		out.append(6144)   # Flower Gift: Attack x1.5 in sun, for the holder and its ally
	var rm := _ruin_mult(st, user, "atk" if not special else "spa")
	if rm != 4096:
		out.append(rm)   # a Ruin ability on the field lowers the stat x0.75
	if user.vol.has("absorb_boost") and int(user.vol.absorb_boost) == int(mv.type):
		out.append(6144)   # Flash Fire (Showdown: onModifyAtk/SpA x1.5 on Fire moves)
	var th := hook(st, target)
	match str(th.get("k", "")):
		"resist_types": if int(mv.type) in th.get("types", []): out.append(2048)
		"water_bubble": if int(mv.type) == TypeChart.FIRE: out.append(2048)
		"heatproof": if int(mv.type) == TypeChart.FIRE: out.append(2048)   # Gen 9: halves the attacker's stat
	return out

## Hustle is a direct x1.5 on the physical attack stat (Showdown uses modify(), not the chain).
static func hustle(st, user: BattleMon, special: bool) -> bool:
	return not special and _k(st, user) == "hustle"

## Defense-stat modifiers on the target (Marvel Scale, Fur Coat, Paradox).
static func def_mods(st, user: BattleMon, target: BattleMon, mv: Dictionary, special: bool) -> Array:
	var out: Array = []
	var th := hook(st, target)
	match str(th.get("k", "")):
		"marvel_scale": if not special and target.status != "": out.append(6144)
		"fur_coat": if not special: out.append(8192)
		"grass_pelt": if not special and st.terrain == "grassy": out.append(6144)
		"paradox":
			if paradox_active(st, target, th):
				var best := best_stat(target)
				if (best == "def" and not special) or (best == "spd" and special):
					out.append(5325)
	if special and _flower_gift_active(st, target):
		out.append(6144)   # Flower Gift: Sp. Def x1.5 in sun, for the holder and its ally
	var rm := _ruin_mult(st, target, "def" if not special else "spd")
	if rm != 4096:
		out.append(rm)   # a Ruin ability on the field lowers the stat x0.75
	return out

## Final damage modifiers (Showdown onModifyDamage / onSourceModifyDamage) from abilities.
static func final_mods(st, user: BattleMon, target: BattleMon, mv: Dictionary, eff: float, crit: bool) -> Array:
	var out: Array = []
	match _k(st, user):
		"tinted_lens": if eff < 1.0: out.append(8192)
		"sniper": if crit: out.append(6144)
		"neuroforce": if eff > 1.0: out.append(5120)
		"stakeout": if int(target.vol.get("turns_in", 0)) == 0: out.append(8192)
	var th := hook(st, target)
	match str(th.get("k", "")):
		"filter": if eff > 1.0: out.append(3072)
		"multiscale": if target.hp >= target.max_hp(): out.append(2048)
		"fluffy":
			if mv.get("contact", false) and not ItemHooks.no_contact(st, user, mv): out.append(2048)
			if int(mv.type) == TypeChart.FIRE: out.append(8192)
		"ice_scales": if int(mv.cat) == 1: out.append(2048)
		"punk_rock": if mv.get("sound", false): out.append(2048)
	var al = st.ally_of(target) if st.is_doubles() else null
	if al != null and _k(st, al) == "friend_guard":
		out.append(3072)
	return out

## Old float API kept for callers outside DamageCalc (AI, tests): product of power_mods.
static func power_mult(st, user: BattleMon, target: BattleMon, mv: Dictionary, power: int) -> float:
	var m := 1.0
	for x in power_mods(st, user, target, mv, power):
		m *= x / 4096.0
	return m

## STAB multiplier (1.5, or 2.0 with "adaptability").
static func stab_mult(st, user: BattleMon) -> float:
	return 2.0 if _k(st, user) == "adaptability" else 1.5

## True if the attacker's burn does not halve its damage ("guts").
static func ignores_burn(st, user: BattleMon) -> bool:
	return _k(st, user) == "guts"

## True if the attacker ignores the target's stat stages / the target ignores the attacker's (Unaware).
static func unaware(st, m: BattleMon) -> bool:
	return _k(st, m) == "unaware"

## Paradox abilities (Protosynthesis in sun, Quark Drive on Electric Terrain); Booster Energy isn't in yet.
static func paradox_active(st, m: BattleMon, h: Dictionary) -> bool:
	if h.has("w"):
		return st.weather == str(h.w) and not weather_suppressed(st)
	if h.has("t"):
		return st.terrain == str(h.t)
	return false

## The highest stat key among atk/def/spa/spd/spe (stages included), ties in that order (Showdown).
static func best_stat(m: BattleMon) -> String:
	var best := "atk"
	var bv := -1
	for k in ["atk", "def", "spa", "spd", "spe"]:
		var v := BattleRules.apply_stage(int(m.stats[k]), int(m.stages[k]))
		if v > bv:
			bv = v
			best = k
	return best

# ------------------------------------------------------------------ immunities

## Extra factor on type effectiveness (1.0 normally; 0.0 to make the target immune: type_immune / absorbs /
## wonder_guard / sound / bullet immunity / telepathy). Absorb effects themselves run in absorb_check().
static func type_eff_mod(st, user: BattleMon, target: BattleMon, mv: Dictionary, eff: float) -> float:
	if user == target:
		return 1.0
	var h := hook(st, target)
	match str(h.get("k", "")):
		"type_immune", "absorb_heal", "absorb_boost", "absorb_stat":
			if int(mv.type) == int(h.type): return 0.0
		"dry_skin":
			if int(mv.type) == TypeChart.WATER: return 0.0
		"wonder_guard":
			if eff <= 1.0 and int(mv.cat) != 2: return 0.0
		"flag_immune":
			if mv.get(str(h.flag), false): return 0.0
		"telepathy":
			if user.side_id == target.side_id: return 0.0
	return 1.0

## Before a move hits: absorb-type abilities swallow the move, other immunities explain themselves.
## Returns a log line ("" = not absorbed).
static func absorb_check(st, user: BattleMon, target: BattleMon, mv: Dictionary) -> String:
	if user == target:
		return ""
	var h := hook(st, target)
	var k := str(h.get("k", ""))
	var an: String = st.bd.ability_name(target.ability)
	if (k == "absorb_heal" and int(mv.type) == int(h.type)) or (k == "dry_skin" and int(mv.type) == TypeChart.WATER):
		if target.hp >= target.max_hp():
			return "%s's %s made the move useless!" % [target.name, an]
		st.heal(target, maxi(1, target.max_hp() / 4), "")
		return "%s's %s restored its HP." % [target.name, an]
	if k == "absorb_boost" and int(mv.type) == int(h.type):
		target.vol["absorb_boost"] = int(h.type)
		return "%s's %s raised the power of its %s-type moves!" % [target.name, an, st.bd.type_name(int(h.type))]
	if k == "absorb_stat" and int(mv.type) == int(h.type):
		st.log_msg("%s's %s took the attack!" % [target.name, an])
		st.boost(target, str(h.st), int(h.get("n", 1)), false)
		return " "
	if k == "wind_rider" and mv.get("wind", false):
		st.boost(target, "atk", 1, false)
		return "%s's %s took the wind!" % [target.name, an]
	if k == "good_as_gold" and int(mv.cat) == 2:
		return "%s's %s blocks status moves!" % [target.name, an]
	if k == "type_immune" and int(mv.type) == int(h.type) and int(mv.cat) == 2:
		return "It doesn't affect %s..." % target.name
	if k == "flag_immune" and mv.get(str(h.flag), false):
		return "%s's %s blocks the move!" % [target.name, an]
	if k == "telepathy" and user.side_id == target.side_id and int(mv.cat) != 2:
		return "%s avoids attacks by its ally Pokémon!" % target.name
	if k == "block_priority" and int(mv.get("eff_pri", mv.pri)) > 0 and user.side_id != target.side_id:
		return "%s's %s blocks the move!" % [target.name, an]
	if k == "overcoat" and mv.get("powder", false):
		return "It doesn't affect %s..." % target.name
	if k == "oblivious" and str(st.bd.effect_of(mv).get("k", "")) in ["attract", "taunt"]:
		return "It doesn't affect %s..." % target.name
	if k == "damp" and str(st.bd.effect_of(mv).get("k", "")) == "explode":
		return "%s's %s prevents the explosion!" % [target.name, an]
	return ""

## Damp anywhere on the field stops explosion moves before they start (user doesn't faint).
static func damp_on_field(st, user: BattleMon) -> BattleMon:
	for m in st.all_active():
		if m != user and _k(st, m) == "damp":
			return m
	return null

# ------------------------------------------------------------------ accuracy / crits / speed

## Accuracy modifiers (4096-based) from the user's and the target's abilities.
static func acc_mods(st, user: BattleMon, target: BattleMon, mv: Dictionary) -> Array:
	var out: Array = []
	var h := hook(st, user)
	match str(h.get("k", "")):
		"acc_mult": out.append(int(4096 * float(h.num) / float(h.den)) + (1 if int(h.num) == 13 else 0))   # Compound Eyes = 5325
		"hustle": if int(mv.cat) == 0: out.append(3277)
		"victory_star": out.append(4505)   # x1.1 accuracy for the holder and its ally
	if st.is_doubles():
		var al = st.ally_of(user)
		if al != null and _k(st, al) == "victory_star":
			out.append(4505)
	if target != null and target != user:
		var th := hook(st, target)
		match str(th.get("k", "")):
			"weather_evasion":
				if st.weather == str(th.w) or (str(th.w) == "hail" and st.weather == "snow"):
					if not weather_suppressed(st): out.append(3277)
	return out

## Old float API (product of acc_mods without a target).
static func acc_mult(st, user: BattleMon, mv: Dictionary) -> float:
	var m := 1.0
	for x in acc_mods(st, user, null, mv):
		m *= x / 4096.0
	return m

## Wonder Skin: status moves aimed at this mon have at most 50 accuracy.
static func wonder_skin(st, target: BattleMon, mv: Dictionary) -> bool:
	return int(mv.cat) == 2 and _k(st, target) == "wonder_skin"

## True if either side has "no_guard" (moves always hit).
static func no_guard(st, user: BattleMon, target: BattleMon) -> bool:
	return _k(st, user) == "no_guard" or _k(st, target) == "no_guard"

## True if the target can't be hit critically.
static func no_crit(st, target: BattleMon) -> bool:
	return _k(st, target) == "no_crit"

## Extra crit stages from the user's ability (Super Luck).
static func crit_stage(st, user: BattleMon) -> int:
	return 1 if _k(st, user) == "crit_up" else 0

## Merciless: always crits a poisoned target.
static func always_crit(st, user: BattleMon, target: BattleMon) -> bool:
	return _k(st, user) == "merciless" and target.status in ["psn", "tox"]

## Speed modifiers (4096-based) from abilities: weather/terrain speed x2, Quick Feet x1.5, Unburden x2,
## paradox x1.5 when Speed is the boosted stat.
static func speed_mods(st, m: BattleMon) -> Array:
	var out: Array = []
	var h := hook(st, m)
	match str(h.get("k", "")):
		"weather_speed":
			var w := str(h.get("w", ""))
			if (st.weather == w or (w == "hail" and st.weather == "snow")) and not weather_suppressed(st):
				out.append(8192)
		"terrain_speed": if st.terrain == str(h.t): out.append(8192)
		"quick_feet": if m.status != "": out.append(6144)
		"unburden": if m.vol.has("unburden"): out.append(8192)
		"paradox": if paradox_active(st, m, h) and best_stat(m) == "spe": out.append(6144)
		"slow_start": if int(m.vol.get("turns_in", 0)) < 5: out.append(2048)
	return out

## Old float API (product of speed_mods).
static func speed_mult(st, m: BattleMon) -> float:
	var x := 1.0
	for v in speed_mods(st, m):
		x *= v / 4096.0
	return x

## True if paralysis does not halve this mon's Speed (Quick Feet).
static func ignores_par_speed(st, m: BattleMon) -> bool:
	return _k(st, m) == "quick_feet"

## Priority change from the user's ability for a move (Prankster +1 on status moves, Gale Wings +1 on
## Flying moves at full HP, Triage +3 on healing moves).
static func priority_bonus(st, m: BattleMon, mv: Dictionary) -> int:
	match _k(st, m):
		"prankster": if int(mv.cat) == 2: return 1
		"gale_wings": if int(mv.type) == TypeChart.FLYING and m.hp >= m.max_hp(): return 1
		"triage": if mv.get("healing", false) or str(st.bd.effect_of(mv).get("k", "")) in ["drain", "heal", "dream_eater", "shore_up", "strength_sap", "weather_heal"]: return 3
		"mycelium_might": if int(mv.cat) == 2: return -7
	return 0

## Stall: moves last within its priority bracket.
static func moves_last(st, m: BattleMon) -> bool:
	return _k(st, m) == "stall"

# ------------------------------------------------------------------ status / stats

## False if the ability blocks status s (also Leaf Guard in sun, Water Bubble vs burn, Comatose-style).
static func allows_status(st, m: BattleMon, s: String) -> bool:
	var h := hook(st, m)
	match str(h.get("k", "")):
		"status_immune": return not (s in h.get("s", []))
		"leaf_guard": return not (st.weather == "sun" and not weather_suppressed(st))
		"water_bubble": return s != "brn"
	# Flower Veil: Grass-type Pokémon (the holder and its ally) can't be given a status.
	if m.has_type(TypeChart.GRASS):
		var al = st.ally_of(m) if st.is_doubles() else null
		if _k(st, m) == "flower_veil" or (al != null and _k(st, al) == "flower_veil"):
			return false
	return true

## False if the ability blocks confusion.
static func allows_confusion(st, m: BattleMon) -> bool:
	return _k(st, m) != "no_confuse"

## False if the ability blocks flinching.
static func allows_flinch(st, m: BattleMon) -> bool:
	return _k(st, m) != "no_flinch"

## False if the target's ability blocks secondary effects of the user's move (Shield Dust).
static func allows_secondary(st, target: BattleMon) -> bool:
	return _k(st, target) != "no_secondary"

## Serene Grace doubles secondary-effect chances.
static func secondary_chance(st, user: BattleMon, pct: int) -> int:
	return mini(100, pct * 2) if _k(st, user) == "serene_grace" else pct

## True if recoil damage is skipped (Rock Head; Magic Guard too).
static func no_recoil(st, m: BattleMon) -> bool:
	return _k(st, m) in ["no_recoil", "magic_guard"]

## True if the mon takes no indirect damage (Magic Guard).
static func magic_guard(st, m: BattleMon) -> bool:
	return _k(st, m) == "magic_guard"

## Number of hits for a 2-5 multi-hit move with "skill_link" (always 5), else -1.
static func forced_hits(st, m: BattleMon) -> int:
	return 5 if _k(st, m) == "skill_link" else -1

## Can a FOE lower this stat of m? (Clear Body / Keen Eye / Hyper Cutter / Big Pecks style blocks).
static func allows_drop(st, m: BattleMon, stat: String) -> bool:
	match _k(st, m):
		"no_stat_drop": return false
		"no_acc_drop": return stat != "acc"
		"no_atk_drop": return stat != "atk"
		"no_def_drop": return stat != "def"
	# Flower Veil: a Grass-type ally's stages can't be lowered by a foe either.
	if m.has_type(TypeChart.GRASS) and st.is_doubles():
		var al = st.ally_of(m)
		if al != null and _k(st, al) == "flower_veil":
			return false
	return true

## Stage change after Contrary / Simple.
static func stage_delta(st, m: BattleMon, n: int) -> int:
	match _k(st, m):
		"contrary": return -n
		"simple": return n * 2
	return n

## After a foe lowered one of m's stats: Defiant / Competitive (+2).
static func on_stat_dropped_by_foe(st, m: BattleMon) -> void:
	var h := hook(st, m)
	if str(h.get("k", "")) == "defiant" and not m.fainted():
		st.log_msg("%s's %s activated!" % [m.name, st.bd.ability_name(m.ability)])
		st.boost(m, str(h.st), 2, false)

## True if the mon can always flee from wild battles.
static func always_run(st, m: BattleMon) -> bool:
	return _k(st, m) == "run_away"

## A foe trapping ability that stops m from switching or fleeing, or "" (Shadow Tag, Arena Trap, Magnet Pull).
## Ghost types are never trapped (Gen 6+), Shadow Tag doesn't trap another Shadow Tag.
static func trapped_by(st, m: BattleMon) -> String:
	if m.has_type(TypeChart.GHOST):
		return ""
	for f in st.foes_of(m):
		var h := hook(st, f)
		if str(h.get("k", "")) != "trap":
			continue
		if h.has("type") and not m.has_type(int(h.type)):
			continue
		if h.get("grounded", false) and not st.is_grounded(m):
			continue
		if not h.has("type") and not h.has("grounded") and _k(st, m) == "trap" and hook(st, m).size() == 1:
			continue   # Shadow Tag vs Shadow Tag
		return st.bd.ability_name(f.ability)
	return ""

## "sturdy" / Disguise: survive a hit. Returns the damage to apply.
static func cap_damage(st, target: BattleMon, dmg: int) -> int:
	if _k(st, target) == "sturdy" and target.hp == target.max_hp() and dmg >= target.hp:
		target.vol["sturdy_hit"] = true
		return target.hp - 1
	return dmg

## True if the target is immune to one-hit-KO moves.
static func blocks_ohko(st, target: BattleMon) -> bool:
	return _k(st, target) == "sturdy"

## Disguise (Gen 8+): the first damaging hit is blocked and the mon loses 1/8 of its max HP instead.
static func disguise_blocks(st, target: BattleMon, mv: Dictionary) -> bool:
	if _k(st, target) != "disguise" or target.vol.has("disguise_busted") or int(mv.cat) == 2:
		return false
	target.vol["disguise_busted"] = true
	target.vol.erase("ability_off")
	st.log_msg("Its disguise served it as a decoy!")
	st.damage(target, maxi(1, target.max_hp() / 8), "%s's disguise was busted!" % target.name)
	return true

## Pressure: moves aimed at this mon use 2 PP.
static func pressure(st, target: BattleMon) -> bool:
	return _k(st, target) == "pressure"

## Unnerve on the foe side: m can't eat berries.
static func unnerved(st, m: BattleMon) -> bool:
	for f in st.foes_of(m):
		if _k(st, f) == "unnerve":
			return true
	return false

## Infiltrator: ignores screens, Substitute, Safeguard and Mist.
static func infiltrates(st, user: BattleMon) -> bool:
	return _k(st, user) == "infiltrator"

## Klutz: the holder's item does nothing.
static func klutz(st, m: BattleMon) -> bool:
	return _k(st, m) == "klutz"

# ------------------------------------------------------------------ event hooks

## After a contact move hits: contact_status / contact_chip / contact_drop / effect_spore / cute_charm on
## the attacker, and the attacker's poison_touch on the target. Returns log lines (kept for old callers).
static func on_contact(st, user: BattleMon, target: BattleMon, mv: Dictionary) -> Array:
	var out: Array = []
	if not mv.get("contact", false) or user.fainted() or user == target or ItemHooks.no_contact(st, user, mv) or no_contact(st, user):
		return out
	var h := hook(st, target)
	var an: String = st.bd.ability_name(target.ability)
	match str(h.get("k", "")):
		"contact_status":
			if user.status == "" and st.rng.chance(int(h.pct)) and BattleRules.can_get_status(st, user, str(h.s)):
				st.set_status(user, str(h.s), "%s's %s" % [target.name, an])
		"contact_chip":
			if not magic_guard(st, user):
				st.damage(user, maxi(1, user.max_hp() / int(h.den)), "%s was hurt by %s's %s!" % [user.name, target.name, an])
		"contact_drop":
			st.log_msg("%s's %s activated!" % [target.name, an])
			st.boost(user, str(h.st), -1, true)
		"effect_spore":
			if user.status == "" and not user.has_type(TypeChart.GRASS) and _k(st, user) != "overcoat" and not ItemHooks.powder_immune(st, user):
				var r: int = st.rng.below(100)
				var s := "slp" if r < 11 else "par" if r < 21 else "psn" if r < 30 else ""
				if s != "" and BattleRules.can_get_status(st, user, s):
					st.set_status(user, s, "%s's %s" % [target.name, an])
		"cute_charm":
			if st.rng.chance(30) and user.gender in [0, 1] and target.gender in [0, 1] and user.gender != target.gender:
				if not user.vol.has("attract") and _k(st, user) != "oblivious":
					user.vol["attract"] = {"side": target.side_id, "slot": target.slot}
					st.log_msg("%s's %s: %s fell in love!" % [target.name, an, user.name])
		"aftermath":
			pass   # on faint, see on_fainted
		"pickpocket":
			if user.item > 0 and target.item == 0 and not sticky_hold(st, user):
				target.item = user.item
				user.item = 0
				user.vol["unburden"] = true
				user.vol.erase("choice_lock")
				st.log_msg("%s's %s stole %s's %s!" % [target.name, an, user.name, st.bd.item_name(target.item)])
		"mummy", "lingering_aroma":
			# The attacker's ability becomes the target's, unless the attacker's ability can't be changed.
			if user.ability != target.ability and not st.bd.ability_name(user.ability) in FIXED_ABILITY_NAMES:
				var from: String = st.bd.ability_name(user.ability)
				if not user.vol.has("orig_ability"):
					user.vol["orig_ability"] = user.ability
				user.ability = target.ability
				st.log_msg("%s's %s: %s's %s became %s!" % [target.name, an, user.name, from, an])
		"wandering_spirit":
			# Swap abilities with the attacker, unless the attacker's ability can't be changed.
			if user.ability != target.ability and not st.bd.ability_name(user.ability) in FIXED_ABILITY_NAMES:
				var from: String = st.bd.ability_name(user.ability)
				var ua := user.ability
				if not user.vol.has("orig_ability"):
					user.vol["orig_ability"] = user.ability
				if not target.vol.has("orig_ability"):
					target.vol["orig_ability"] = target.ability
				user.ability = target.ability
				target.ability = ua
				st.log_msg("%s's %s swapped abilities with %s's %s!" % [target.name, an, user.name, from])
		"perish_body":
			if not user.vol.has("perish") and not target.vol.has("perish"):
				user.vol["perish"] = 4
				target.vol["perish"] = 4
				st.log_msg("%s's %s: both Pokémon will faint in three turns!" % [target.name, an])
	if _k(st, user) == "poison_touch" and not target.fainted() and target.status == "" and st.rng.chance(30):
		if BattleRules.can_get_status(st, target, "psn"):
			st.set_status(target, "psn", "%s's %s" % [user.name, st.bd.ability_name(user.ability)])
	return out

## After a damaging hit landed on target (target still standing or not): Justified, Rattled, Stamina, Weak
## Armor, Anger Point, Cursed Body, Berserk (hp_before = HP before the hit).
static func on_hit_taken(st, user: BattleMon, target: BattleMon, mv: Dictionary, crit: bool, hp_before: int) -> void:
	if target.fainted():
		if _k(st, target) == "aftermath" and mv.get("contact", false) and not user.fainted() and damp_on_field(st, null) == null:
			if not magic_guard(st, user) and not ItemHooks.no_contact(st, user, mv):
				st.damage(user, maxi(1, user.max_hp() / 4), "%s was hurt by %s's %s!" % [user.name, target.name, st.bd.ability_name(target.ability)])
		if _k(st, target) == "innards_out" and not user.fainted() and not magic_guard(st, user):
			st.damage(user, hp_before, "%s's %s hurt it!" % [target.name, st.bd.ability_name(target.ability)])
		return
	var h := hook(st, target)
	match str(h.get("k", "")):
		"justified": if int(mv.type) == TypeChart.DARK: st.boost(target, "atk", 1, false)
		"rattled": if int(mv.type) in [TypeChart.BUG, TypeChart.GHOST, TypeChart.DARK]: st.boost(target, "spe", 1, false)
		"stamina": st.boost(target, "def", 1, false)
		"weak_armor":
			if int(mv.cat) == 0:
				st.boost(target, "def", -1, false)
				st.boost(target, "spe", 2, false)
		"anger_point":
			if crit and int(target.stages.atk) < 6:
				st.log_msg("%s maxed its Attack!" % target.name)
				target.stages["atk"] = 6
				st.emit({"e": "stage", "side": target.side_id, "slot": target.slot, "stat": "atk", "n": 12})
		"cursed_body":
			if user != target and not user.vol.has("disabled") and st.rng.chance(30):
				var i := user.move_index(int(mv.get("id", -1)))
				if i >= 0:
					user.vol["disabled"] = {"idx": i, "turns": 4}
					st.log_msg("%s's %s disabled %s's %s!" % [target.name, st.bd.ability_name(target.ability), user.name, mv.name])
		"berserk":
			if hp_before * 2 > target.max_hp() and target.hp * 2 <= target.max_hp():
				st.boost(target, "spa", 1, false)
		"color_change":
			if int(mv.cat) != 2 and int(mv.type) != TypeChart.MYSTERY and target.types != [int(mv.type), int(mv.type)]:
				if not target.vol.has("orig_types"):
					target.vol["orig_types"] = target.types.duplicate()
				target.types = [int(mv.type), int(mv.type)]
				st.log_msg("%s's %s: it became the %s type!" % [target.name, st.bd.ability_name(target.ability), st.bd.type_name(int(mv.type))])
		"water_compaction":
			if int(mv.type) == TypeChart.WATER:
				st.boost(target, "def", 2, false)
		"sand_spit":
			st.set_weather("sand", ItemHooks.weather_turns(st, target, "sand"), true)
		"seed_sower":
			st.set_terrain("grassy", ItemHooks.terrain_turns(st, target), true)
		"steam_engine":
			if int(mv.type) in [TypeChart.FIRE, TypeChart.WATER]:
				st.boost(target, "spe", 6, false)
		"anger_shell":
			if hp_before * 2 > target.max_hp() and target.hp * 2 <= target.max_hp():
				st.boost(target, "def", 1, false)
				st.boost(target, "spd", 1, false)
		"cotton_down":
			for x in st.all_active():
				if x != target:
					st.boost(x, "spe", -1, x.side_id != target.side_id)
		"toxic_debris":
			if int(mv.cat) == 0:
				var sd: Dictionary = st.hazards(st.side_of(user))
				if int(sd.get("toxic_spikes", 0)) < 2:
					sd["toxic_spikes"] = int(sd.get("toxic_spikes", 0)) + 1
					st.log_msg("Poison spikes were scattered on the ground all around %s team!" % ("your" if user.side_id == 0 else "the opposing"))
		"toxic_chain":
			if mv.get("contact", false) and not user.fainted() and user.status == "" and not ItemHooks.no_contact(st, user, mv) and st.rng.chance(30):
				if BattleRules.can_get_status(st, user, "tox"):
					st.set_status(user, "tox", "%s's %s" % [target.name, st.bd.ability_name(target.ability)])
		"wind_power":
			if mv.get("wind", false):
				target.vol["wind_charged"] = true
				st.log_msg("%s's %s is charged with wind!" % [target.name, st.bd.ability_name(target.ability)])
		"electromorphosis":
			target.vol["electro_charged"] = true
			st.log_msg("%s's %s is charged with electricity!" % [target.name, st.bd.ability_name(target.ability)])
		"wimp_out":
			# Switch out when HP falls to half or below from the hit (once per switch-in).
			if hp_before * 2 > target.max_hp() and target.hp * 2 <= target.max_hp() and not target.vol.has("wimp_out_done"):
				target.vol["wimp_out_done"] = true
				st.log_msg("%s's %s activated!" % [target.name, st.bd.ability_name(target.ability)])
				st.request_pivot(target)
	# Magician (on the ATTACKER): steal the target's item when a damaging move hits.
	if _k(st, user) == "magician" and int(mv.cat) != 2 and user.item == 0 and target.item > 0 and not sticky_hold(st, target):
		user.item = target.item
		target.item = 0
		target.vol["unburden"] = true
		target.vol.erase("choice_lock")
		st.log_msg("%s's %s stole %s's %s!" % [user.name, st.bd.ability_name(user.ability), target.name, st.bd.item_name(user.item)])

## When m knocks out a foe with a move: Moxie / Beast Boost.
static func on_ko(st, m: BattleMon) -> void:
	if m.fainted():
		return
	var h := hook(st, m)
	match str(h.get("k", "")):
		"moxie": st.boost(m, str(h.st), 1, false)
		"beast_boost": st.boost(m, best_stat_raw(m), 1, false)

## Highest raw stat (no stages), Beast Boost rule.
static func best_stat_raw(m: BattleMon) -> String:
	var best := "atk"
	var bv := -1
	for k in ["atk", "def", "spa", "spd", "spe"]:
		if int(m.stats[k]) > bv:
			bv = int(m.stats[k])
			best = k
	return best

## After m was given a status by `source` (a foe): Synchronize passes brn/par/psn back.
static func on_status_from(st, m: BattleMon, source: BattleMon, s: String) -> void:
	if source == null or source == m or source.fainted():
		return
	if _k(st, m) == "synchronize" and s in ["brn", "par", "psn", "tox"] and source.status == "":
		var back := "psn" if s == "tox" else s
		if BattleRules.can_get_status(st, source, back):
			st.set_status(source, back, "%s's %s" % [m.name, st.bd.ability_name(m.ability)])

## When a mon enters the field: Intimidate (with the Gen 8 immunities), weather and terrain setters,
## Trace, Download, Frisk, Intrepid Sword style boosts.
static func on_entry(st, m: BattleMon) -> void:
	var h := hook(st, m)
	var an: String = st.bd.ability_name(m.ability)
	match str(h.get("k", "")):
		"entry_drop_foe":
			for foe in st.foes_of(m):
				st.log_msg("%s's %s affects %s!" % [m.name, an, foe.name])
				var fk := _k(st, foe)
				if fk in ["no_flinch", "no_confuse", "oblivious", "scrappy"] or ItemHooks.key(st, foe) == "clear_amulet":
					st.log_msg("%s's %s prevents it from being affected!" % [foe.name, st.bd.ability_name(foe.ability)])
					continue
				for k in h.st:
					st.boost(foe, k, int(h.st[k]), true)
				if fk == "rattled":
					st.boost(foe, "spe", 1, false)
		"entry_weather":
			# Snow Warning sets Gen 9 snow (expansion GEN_LATEST; this ROM has Snowscape, so it has snow).
			var w := "snow" if str(h.w) == "hail" else str(h.w)
			st.set_weather(w, ItemHooks.weather_turns(st, m, w), true)
		"entry_terrain":
			st.set_terrain(str(h.t), ItemHooks.terrain_turns(st, m), true)
		"trace":
			var foes: Array = st.foes_of(m)
			if not foes.is_empty():
				var f: BattleMon = foes[st.rng.below(foes.size())]
				var fk := _raw_key(st, f.ability)
				if fk != "trace" and f.ability > 0:
					if not m.vol.has("orig_ability"):
						m.vol["orig_ability"] = m.ability
					m.ability = f.ability
					st.log_msg("%s traced %s's %s!" % [m.name, f.name, st.bd.ability_name(f.ability)])
					on_entry(st, m)
		"download":
			var d := 0
			var sd := 0
			for f in st.foes_of(m):
				d += BattleRules.apply_stage(int(f.stats.def), int(f.stages.def))
				sd += BattleRules.apply_stage(int(f.stats.spd), int(f.stages.spd))
			if d > 0 or sd > 0:
				st.boost(m, "spa" if d >= sd else "atk", 1, false)
		"frisk":
			for f in st.foes_of(m):
				if f.item > 0:
					st.log_msg("%s frisked %s and found its %s!" % [m.name, f.name, st.bd.item_name(f.item)])
		"entry_boost":
			if not m.vol.has("entry_boost_done"):
				st.boost(m, str(h.st), 1, false)
		"cloud_nine":
			st.log_msg("The effects of the weather disappeared.")
		"mold_breaker":
			st.log_msg("%s breaks the mold!" % m.name)
		"unnerve":
			st.log_msg("The opposing team is too nervous to eat Berries!" if m.side_id == 0 else "Your team is too nervous to eat Berries!")
		"pressure":
			st.log_msg("%s is exerting its pressure!" % m.name)
		"neutralizing_gas":
			st.log_msg("Neutralizing Gas filled the air!")
		"orichalcum_pulse":
			st.set_weather("sun", ItemHooks.weather_turns(st, m, "sun"), true)
		"hadron_engine":
			st.set_terrain("electric", ItemHooks.terrain_turns(st, m), true)
		"screen_cleaner":
			for sd in st.sides:
				for c in ["reflect", "lightscreen", "aurora_veil"]:
					sd.cond.erase(c)
			st.log_msg("%s's %s removed the screens!" % [m.name, an])
		"supersweet_syrup":
			for foe in st.foes_of(m):
				st.boost(foe, "eva", -1, true)
		"curious_medicine":
			var alm = st.ally_of(m) if st.is_doubles() else null
			if alm != null:
				alm.reset_stages()
				st.log_msg("%s's %s reset %s's stat changes!" % [m.name, an, alm.name])
		"hospitality":
			var alh = st.ally_of(m) if st.is_doubles() else null
			if alh != null and alh.hp < alh.max_hp():
				st.heal(alh, maxi(1, alh.max_hp() / 4), "%s's %s restored %s's HP!" % [m.name, an, alh.name])
		"costar":
			var alc = st.ally_of(m) if st.is_doubles() else null
			if alc != null:
				m.stages = alc.stages.duplicate()
				st.log_msg("%s's %s copied %s's stat changes!" % [m.name, an, alc.name])
		"anticipation":
			for foe in st.foes_of(m):
				for mid in foe.moves:
					var mid_id := int(mid.get("id", -1)) if mid is Dictionary else int(mid)
					var fmv: Dictionary = st.bd.move(mid_id)
					if fmv.is_empty():
						continue
					var eff := TypeChart.effectiveness(st.bd, int(fmv.type), m)
					if eff > 1.0 or str(st.bd.effect_of(fmv).get("k", "")) == "ohko":
						st.log_msg("%s shuddered!" % m.name)
						return
		"forewarn":
			var best_mv := ""
			var best_pw := -1
			var best_foe: BattleMon = null
			for foe in st.foes_of(m):
				for mid in foe.moves:
					var mid_id := int(mid.get("id", -1)) if mid is Dictionary else int(mid)
					var fmv: Dictionary = st.bd.move(mid_id)
					if fmv.is_empty():
						continue
					if int(fmv.power) > best_pw:
						best_pw = int(fmv.power)
						best_mv = str(fmv.name)
						best_foe = foe
			if best_foe != null:
				st.log_msg("%s's %s alerted it to %s's %s!" % [m.name, an, best_foe.name, best_mv])
		"forecast":
			_forecast_apply(st, m)

## End of turn for one mon (ability part). Speed Boost, Moody, Shed Skin, Hydration, weather healing,
## Dry Skin / Solar Power chip.
static func on_turn_end(st, m: BattleMon) -> void:
	if m.fainted():
		return
	var h := hook(st, m)
	var ws: bool = weather_suppressed(st)
	match str(h.get("k", "")):
		"speed_boost":
			if int(m.stages.spe) < 6 and m.vol.get("turns_in", 0) > 0:
				st.boost(m, "spe", 1, false)
		"moody":
			var ups: Array = []
			var downs: Array = []
			for k in ["atk", "def", "spa", "spd", "spe"]:
				if int(m.stages[k]) < 6: ups.append(k)
			if not ups.is_empty():
				var u: String = ups[st.rng.below(ups.size())]
				for k in ["atk", "def", "spa", "spd", "spe"]:
					if int(m.stages[k]) > -6 and k != u: downs.append(k)
				st.boost(m, u, 2, false)
				if not downs.is_empty():
					st.boost(m, downs[st.rng.below(downs.size())], -1, false)
		"shed_skin":
			if m.status != "" and st.rng.ratio(1, 3):
				st.cure(m, "%s shed its skin!" % m.name)
		"hydration":
			if m.status != "" and st.weather == "rain" and not ws:
				st.cure(m, "%s's %s cured its status!" % [m.name, st.bd.ability_name(m.ability)])
		"healer":
			var al = st.ally_of(m) if st.is_doubles() else null
			if al != null and al.status != "" and st.rng.chance(30):
				st.cure(al, "%s's %s cured %s!" % [m.name, st.bd.ability_name(m.ability), al.name])
		"bad_dreams":
			for f in st.foes_of(m):
				if f.status == "slp" and not f.fainted():
					st.damage(f, maxi(1, f.max_hp() / 8), "%s is tormented by bad dreams!" % f.name)
		"harvest":
			# If the mon ate a berry earlier (ItemHooks.consume records it), restore it: always in sun,
			# otherwise a 50% chance.
			if m.item == 0 and m.vol.has("ate_berry_item"):
				var sun: bool = st.weather == "sun" and not weather_suppressed(st)
				if sun or st.rng.chance(50):
					m.item = int(m.vol["ate_berry_item"])
					m.vol.erase("ate_berry_item")
					st.log_msg("%s harvested its %s!" % [m.name, st.bd.item_name(m.item)])

## Weather-phase ability effects (run right after weather damage): Rain Dish, Ice Body, Dry Skin, Solar Power.
## Returns true when the ability replaced the weather chip (Ice Body in hail).
static func on_weather(st, m: BattleMon) -> void:
	if m.fainted() or weather_suppressed(st):
		return
	var h := hook(st, m)
	var an: String = st.bd.ability_name(m.ability)
	match str(h.get("k", "")):
		"weather_heal":
			var w := str(h.w)
			if (st.weather == w or (w == "hail" and st.weather == "snow")) and m.hp < m.max_hp() and not m.vol.has("heal_block"):
				st.heal(m, maxi(1, m.max_hp() / 16), "%s's %s restored its HP." % [m.name, an])
		"dry_skin":
			if st.weather == "rain" and m.hp < m.max_hp():
				st.heal(m, maxi(1, m.max_hp() / 8), "%s's %s restored its HP." % [m.name, an])
			elif st.weather == "sun":
				st.damage(m, maxi(1, m.max_hp() / 8), "%s's %s hurt it." % [m.name, an])
		"solar_power":
			if st.weather == "sun":
				st.damage(m, maxi(1, m.max_hp() / 8), "%s's %s hurt it." % [m.name, an])

## When the weather changes: Forecast changes Castform's type to match the weather.
static func on_weather_change(st, m: BattleMon) -> void:
	if m.fainted():
		return
	if _k(st, m) == "forecast":
		_forecast_apply(st, m)

## Forecast: Fire in sun, Water in rain, Ice in hail/snow, Normal otherwise.
static func _forecast_apply(st, m: BattleMon) -> void:
	var t := TypeChart.NORMAL
	match st.weather:
		"sun": t = TypeChart.FIRE
		"rain": t = TypeChart.WATER
		"hail", "snow": t = TypeChart.ICE
	if weather_suppressed(st):
		t = TypeChart.NORMAL
	if m.types == [t, t]:
		return
	if not m.vol.has("orig_types"):
		m.vol["orig_types"] = m.types.duplicate()
	m.types = [t, t]
	st.log_msg("%s's %s: it became the %s type!" % [m.name, st.bd.ability_name(m.ability), st.bd.type_name(t)])

## When the terrain changes: Mimicry changes the mon's type to the terrain's type.
static func on_terrain_change(st, m: BattleMon) -> void:
	if m.fainted() or _k(st, m) != "mimicry":
		return
	var t := -1
	match st.terrain:
		"electric": t = TypeChart.ELECTRIC
		"grassy": t = TypeChart.GRASS
		"misty": t = TypeChart.FAIRY
		"psychic": t = TypeChart.PSYCHIC
	if t < 0:
		if m.vol.has("orig_types"):
			m.types = m.vol["orig_types"].duplicate()
			m.vol.erase("orig_types")
		return
	if m.types == [t, t]:
		return
	if not m.vol.has("orig_types"):
		m.vol["orig_types"] = m.types.duplicate()
	m.types = [t, t]
	st.log_msg("%s's %s: it became the %s type!" % [m.name, st.bd.ability_name(m.ability), st.bd.type_name(t)])

## When a mon faints (called from BattleState._check_faints for each fainted mon): Soul-Heart raises the
## holder's Sp. Atk by 1 when ANY other Pokémon faints; Power of Alchemy / Receiver copies a fainted
## ally's ability.
static func on_faint(st, fainted: BattleMon) -> void:
	for m in st.all_active():
		if m == fainted or m.fainted():
			continue
		match _k(st, m):
			"soul_heart":
				st.boost(m, "spa", 1, false)
			"power_of_alchemy", "receiver":
				if fainted.side_id == m.side_id and fainted.slot >= 0 and fainted.slot != m.slot \
						and fainted.ability > 0 and not st.bd.ability_name(fainted.ability) in FIXED_ABILITY_NAMES:
					if not m.vol.has("orig_ability"):
						m.vol["orig_ability"] = m.ability
					m.ability = fainted.ability
					st.log_msg("%s acquired %s's %s!" % [m.name, fainted.name, st.bd.ability_name(fainted.ability)])

## True if this mon takes no sandstorm/hail damage because of its ability.
static func weather_immune(st, m: BattleMon, w: String) -> bool:
	var h := hook(st, m)
	match str(h.get("k", "")):
		"overcoat", "magic_guard": return true
		"weather_evasion": return str(h.w) == w
		"weather_heal": return w == "hail" and str(h.w) == "hail"
		"weather_speed": return str(h.w) == w
		"sand_force": return w == "sand"
	return false

## When a mon switches out: Natural Cure heals status, Regenerator restores 1/3 HP.
static func on_switch_out(st, m: BattleMon) -> void:
	match _k(st, m):
		"natural_cure":
			if m.status != "":
				m.status = ""
				m.status_turns = 0
		"regenerator":
			if not m.fainted() and not m.vol.has("heal_block"):
				m.hp = mini(m.max_hp(), m.hp + m.max_hp() / 3)

## Early Bird: sleep counts down twice as fast.
static func early_bird(st, m: BattleMon) -> bool:
	return _k(st, m) == "early_bird"

## Poison Heal: poison heals 1/8 instead of hurting.
static func poison_heal(st, m: BattleMon) -> bool:
	return _k(st, m) == "poison_heal"

## Liquid Ooze: draining this mon hurts the drainer.
static func liquid_ooze(st, m: BattleMon) -> bool:
	return _k(st, m) == "liquid_ooze"

## Corrosion: the user can poison Steel and Poison types.
static func corrosion(st, m: BattleMon) -> bool:
	return m != null and _k(st, m) == "corrosion"

## Truant: every other turn the mon loafs around.
static func truant(st, m: BattleMon) -> bool:
	return _k(st, m) == "truant"

## Protean / Libero (Gen 9: once per switch-in): the user becomes the type of the move it is about to use.
static func protean(st, m: BattleMon, mv: Dictionary) -> void:
	if _k(st, m) != "protean" or m.vol.has("protean_done") or int(mv.type) == TypeChart.MYSTERY:
		return
	m.vol["protean_done"] = true
	if m.types == [int(mv.type), int(mv.type)]:
		return
	m.types = [int(mv.type), int(mv.type)]
	st.log_msg("%s's %s: it became the %s type!" % [m.name, st.bd.ability_name(m.ability), st.bd.type_name(int(mv.type))])

## Scrappy / Mind's Eye: Normal and Fighting moves hit Ghost types.
static func scrappy(st, user: BattleMon) -> bool:
	return _k(st, user) == "scrappy"

## The type a move becomes with the user's ability (-ate abilities and Normalize). Returns -1 for no change.
static func move_type_override(st, user: BattleMon, mv: Dictionary) -> int:
	var h := hook(st, user)
	match str(h.get("k", "")):
		"ate": if int(mv.type) == TypeChart.NORMAL: return int(h.type)
		"normalize": return TypeChart.NORMAL
	return -1

## Gluttony: pinch berries meant for 1/4 HP are eaten at 1/2 HP.
static func gluttony(st, m: BattleMon) -> bool:
	return _k(st, m) == "gluttony"

## Sticky Hold: the item can't be removed by a foe.
static func sticky_hold(st, m: BattleMon) -> bool:
	return _k(st, m) == "sticky_hold"

## Suction Cups / Guard Dog: can't be forced out.
static func suction_cups(st, m: BattleMon) -> bool:
	return _k(st, m) in ["suction_cups", "guard_dog"]

## Ice Face (Gen 8+): the first physical hit is blocked outright (no HP loss, unlike Disguise).
static func ice_face_blocks(st, target: BattleMon, mv: Dictionary) -> bool:
	if _k(st, target) != "ice_face" or target.vol.has("ice_face_busted") or int(mv.cat) != 0:
		return false
	target.vol["ice_face_busted"] = true
	st.log_msg("Its ice face took the hit!")
	return true

## Unseen Fist: contact moves ignore Protect / Detect / King's Shield / Spiky Shield.
static func unseen_fist(st, m: BattleMon) -> bool:
	return _k(st, m) == "unseen_fist"

## Stalwart / Propeller Tail: the user's moves ignore Follow Me / Rage Powder redirection.
static func ignores_redirect(st, m: BattleMon) -> bool:
	return _k(st, m) in ["stalwart", "propeller_tail"]

## Quick Draw: 30% chance to move first within the priority bracket.
static func quick_draw(st, m: BattleMon) -> bool:
	return _k(st, m) == "quick_draw" and st.rng.chance(30)

## Long Reach: the user's contact moves don't make contact (no Rocky Helmet / Iron Barbs / contact
## abilities, and no contact-based item effects).
static func no_contact(st, m: BattleMon) -> bool:
	return _k(st, m) == "long_reach"

## Gorilla Tactics: the move lock, like a Choice item (shares the "choice_lock" vol key; the lock is
## set in BattleState.use_move and enforced in move_blocked).
static func choice_lock(st, m: BattleMon) -> int:
	if _k(st, m) == "gorilla_tactics" and m.vol.has("choice_lock"):
		return int(m.vol["choice_lock"])
	return -1

## Dark/Fairy Aura field multiplier for a move type (x4/3, reversed to x3/4 by Aura Break on the field).
static func _aura_mult(st, move_type: int) -> int:
	var found := false
	for m in st.all_active():
		var h := hook(st, m)
		if str(h.get("k", "")) == "aura" and int(h.type) == move_type:
			found = true
			break
	if not found:
		return 4096
	return 3072 if _aura_break_on_field(st) else 5461

static func _aura_break_on_field(st) -> bool:
	for m in st.all_active():
		if _k(st, m) == "aura_break":
			return true
	return false

## Ruin ability field multiplier (x0.75) for a stat, when a Ruin holder is on the field (not the mon
## itself). Vessel = SpA, Sword = Def, Tablets = SpD, Beads = Atk.
static func _ruin_mult(st, m: BattleMon, stat: String) -> int:
	for x in st.all_active():
		if x == m:
			continue
		var h := hook(st, x)
		if str(h.get("k", "")) == "ruin" and str(h.get("st", "")) == stat:
			return 3072
	return 4096

## Plus / Minus: the user's Sp. Atk x1.5 when its ally has Plus or Minus (doubles only).
static func _plus_minus_active(st, user: BattleMon) -> bool:
	if not st.is_doubles():
		return false
	var al = st.ally_of(user)
	return al != null and _k(st, al) == "plus_minus"

## Flower Gift: Attack / Sp. Def x1.5 in sun, for the holder and its ally.
static func _flower_gift_active(st, m: BattleMon) -> bool:
	if st.weather != "sun" or weather_suppressed(st):
		return false
	if _k(st, m) == "flower_gift":
		return true
	if st.is_doubles():
		var al = st.ally_of(m)
		return al != null and _k(st, al) == "flower_gift"
	return false

## Magic Bounce: reflects reflectable status moves back at the user.
static func magic_bounce(st, m: BattleMon) -> bool:
	return _k(st, m) == "magic_bounce"

## Aroma Veil (the mon and allies): immune to Taunt, Encore, Torment, Disable, Heal Block, Attract.
static func aroma_veiled(st, m: BattleMon) -> bool:
	if _k(st, m) == "aroma_veil":
		return true
	var al = st.ally_of(m) if st.is_doubles() else null
	return al != null and _k(st, al) == "aroma_veil"

## Steadfast: +1 Speed when the mon flinches.
static func on_flinch(st, m: BattleMon) -> void:
	if _k(st, m) == "steadfast":
		st.boost(m, "spe", 1, false)

## Fire-type power boost after an absorb_boost (flash-fire style) activation (old API, 1.0/1.5).
static func absorb_boost_mult(_st, user: BattleMon, mv: Dictionary) -> float:
	return 1.5 if user.vol.has("absorb_boost") and int(user.vol.absorb_boost) == int(mv.type) else 1.0
